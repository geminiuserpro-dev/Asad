{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A Lovable project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "placeholderBg": { "type": "string" },
        "published": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "project" },
      "description": "Projects created by users"
    }
  }
}
